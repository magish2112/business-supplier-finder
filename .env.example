# Скопируйте в .env и настройте под своё окружение.

# --- Flask (веб) ---
SECRET_KEY=замените_на_случайную_строку_в_продакшене
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- JSON API (A1): если задан API_KEY, защищённые пути требуют заголовок
# X-API-Key: <значение> или Authorization: Bearer <значение>
# Для Docker/прода задайте длинный случайный ключ. Локально можно оставить пустым.
API_KEY=
# true — приложение не стартует без API_KEY (жёсткий прод)
API_KEY_REQUIRED=false

# --- SQLite ---
SUPPLIER_DB_PATH=supplier_finder.db
# ORCHESTRATION_DB_PATH=  # если не задан — тот же файл, что и SUPPLIER_DB_PATH

# --- Пример базы поставщиков (Excel) ---
# Относительный путь — от корня проекта
SUPPLIER_EXCEL_PATH=data/baza postavshiki.xlsx
# После init_db автоматически импортировать строки из Excel (true/false)
IMPORT_SUPPLIERS_EXCEL_ON_INIT=true

# --- LLM: общий переключатель провайдера ---
# anthropic | openai | openai_compatible | ollama | none
# Алиасы: claude → anthropic; perplexity, groq, litellm, vllm → openai_compatible
LLM_PROVIDER=none

# Таймаут и лимит (для всех провайдеров, где применимо)
LLM_TIMEOUT_SEC=120
LLM_MAX_TOKENS=2048
# Логировать каждый запрос к модели (true/false)
LLM_LOG_REQUESTS=false

# --- Anthropic (Claude), если LLM_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- OpenAI, если LLM_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- OpenAI-совместимый API (Perplexity, vLLM, прокси LiteLLM и т.д.) ---
# Достаточно задать LLM_PROVIDER=perplexity и PERPLEXITY_API_KEY — base URL подставится сам.
OPENAI_BASE_URL=
# Для Perplexity можно использовать только PERPLEXITY_API_KEY (без OPENAI_API_KEY):
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro

# --- Ollama (локально), если LLM_PROVIDER=ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- SMTP (integrations/email_service.py) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_DRY_RUN=true

# --- Ops / Redis (опционально; в Docker — compose-профиль with-redis) ---
# Фоновые задачи POST /api/v1/search: при JOB_QUEUE_ENABLED=true и заданном REDIS_URL
# задачи ставятся в очередь RQ (имя очереди bizsf). Отдельно запустите воркер из корня проекта:
#   python -m jobs.worker
# Установите зависимости: rq и redis (см. requirements.txt).
# JOB_QUEUE_ENABLED=false
# REDIS_URL=redis://redis:6379/0
